# Copy to .env.local and fill in values from your Supabase dev project
# (Project Settings → API). Never commit .env.local.

# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show the "Continue with Google" button (configure the provider in Supabase first)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server only (never prefix with NEXT_PUBLIC_). Not needed in Phase 1.
# SUPABASE_SECRET_KEY=sb_secret_xxx
